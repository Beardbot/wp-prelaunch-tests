# Copy this file to .env and fill in your values.
# .env must never be committed to version control.
#
# Wrap any value containing a '#' (or spaces) in double quotes, e.g.
# WP_LOGIN_PASSWORD="p@ss#word" — an unquoted '#' is read as a comment and the
# value is silently truncated. The CLI warns on startup if it spots this.

# SMTP credentials for email notifications
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=alerts@yourdomain.com
SMTP_TO=you@yourdomain.com

# Optional: path to a sites.json stored outside the project
# (e.g. a shared OneDrive folder — useful for keeping staging credentials off your machine)
# SITES_CONFIG=C:\Users\You\OneDrive\wp-prelaunch\sites.json

# Secret token for the webhook server (used by the WordPress plugin and post-deploy hooks)
WP_PRELAUNCH_SECRET=replace-with-a-long-random-secret

# Slack incoming webhook for failure notifications
# (also enable notifications.slack in sites.json settings)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX

# Test customer credentials — used by the login journey (staging only)
TEST_CUSTOMER_EMAIL=testcustomer@youragency.com
TEST_CUSTOMER_PASSWORD=

# Per-site overrides — use the site key (uppercased, hyphens/dots → underscores)
# TEST_CUSTOMER_EMAIL_EXAMPLE_SHOP=othercustomer@youragency.com
# TEST_CUSTOMER_PASSWORD_EXAMPLE_SHOP=

# Companion sensor plugin (beardbot-sensors, see docs/plugin.md) — a WordPress
# application password for a service user holding the manage_beardbot_sensors
# capability. Application passwords contain spaces: ALWAYS wrap in quotes.
# Staging only. Used only for sites with "sensors": { "enabled": true }.
BEARDBOT_SENSOR_USER=
BEARDBOT_SENSOR_APP_PASSWORD=""
# Per-site overrides — same site-key convention as the other credentials below
# BEARDBOT_SENSOR_USER_TEST_BEARDBOT_DEV=beardbot-sensors
# BEARDBOT_SENSOR_APP_PASSWORD_TEST_BEARDBOT_DEV="xxxx xxxx xxxx xxxx xxxx xxxx"

# WordPress login — used to get past Elementor maintenance mode on staging sites
# whose config has "auth": { "type": "wp-login" }. This is a WordPress user
# account (a role Elementor's maintenance mode lets through), NOT the WooCommerce
# test customer above. Staging only — never point this at production.
WP_LOGIN_USER=
WP_LOGIN_PASSWORD=
# Per-site overrides — same site-key convention as above
# WP_LOGIN_USER_EXAMPLE_MEMBERS=staging-editor
# WP_LOGIN_PASSWORD_EXAMPLE_MEMBERS=
