{
    "name": "beardbot/wpt-sensors",
    "description": "Read-only sensor plugin for the wp-prelaunch-tests runner: inventory, pre-flight audit, and effect verification over authenticated REST",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "WptSensors\\": "wpt-sensors/includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
