{
  "name": "wp-prelaunch-tests",
  "version": "1.0.0",
  "description": "Pre-launch functional testing for WordPress/Elementor sites",
  "main": "index.js",
  "bin": {
    "prelaunch-test": "./bin/test.js",
    "prelaunch-baseline": "./bin/baseline.js",
    "prelaunch-add-site": "./bin/add-site.js"
  },
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "baseline": "node index.js --mode baseline",
